node_modules/
*.log

# Frame dumps from a render in progress.
docs/.frames-*/

# The full-size loops, kept for posting rather than for the repo: at 150 frames
# a gif of one of these runs to 15 MB. docs/readme-*.gif are the reduced
# versions the README embeds, and both come back from `npm run render`.
docs/rivers-britain.gif
docs/rivers-europe.gif
docs/quakes.gif
docs/cyclones.gif

# Raw downloads and the larger derived datasets. Everything here is
# reproducible from the scripts in scripts/, and together they run to a few
# hundred megabytes.
data/HydroRIVERS_*
data/ne_10m_*.geojson
data/rivers-europe.geojson
data/quakes.geojson
data/ibtracs.*.csv
data/cyclones.geojson

# data/rivers-britain.geojson IS committed, deliberately: it is 6.8 MB and it
# means `npm run render` works straight after a clone, without a 250 MB
# download first.
data/world-coastline.geojson
data/world-countries.geojson
data/power-plants.csv
docs/powerplants.gif
